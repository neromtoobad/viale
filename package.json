{
  "name": "viale",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "spike:anchor": "node src/chain/anchor.ts",
    "spike:pay": "node spike/pay.ts",
    "build:web": "esbuild web/prove.ts --bundle --format=esm --target=es2022 --minify --outfile=dist/prove/app.js --loader:.svg=dataurl --loader:.png=dataurl --loader:.woff2=dataurl --loader:.woff=dataurl --loader:.ttf=dataurl --define:process.env.NODE_ENV='\"production\"' --define:global=globalThis",
    "typecheck": "tsc -p .",
    "test": "node --test src/**/*.test.ts",
    "server": "npm run build:web && node src/server/index.ts",
    "verifier": "docker compose -f verifier/docker-compose.yml up -d",
    "proof:try": "npm run build:web && node src/proof/try.ts",
    "errand": "npm run build:web && node src/agent/errand.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@concordium/verification-web-ui": "^0.2.1",
    "@concordium/web-sdk": "^12.0.3",
    "@noble/ed25519": "^2.3.0",
    "@scure/bip39": "^1.6.0",
    "@x402/concordium": "^2.32.0",
    "@x402/core": "^2.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
