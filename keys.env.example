# Copy to ~/.viale-keys/keys.env (outside the repo, chmod 600). Never commit the real file.
# Testnet accounts: make them with the Concordium wallet, fund them from the testnet faucet,
# and get EUDemo (the test euro) for the agent from Concordium's EUDemo page.

# The errand agent's account: it signs its x402 payments. Holds EUDemo, needs no CCD.
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=

# Viale's own account: x402 facilitator (pays the CCD fee for every payment) and errand-log anchors.
SPONSOR_ADDRESS=

# Claude API key for the errand agent (model claude-opus-5-5).
ANTHROPIC_API_KEY=

# Only for the 18+ proof page (Concordium Verify & Access over WalletConnect).
WALLETCONNECT_PROJECT_ID=

# Also in ~/.viale-keys (made by the scripts, never committed):
#   accounts.json  [{ "address", "signKey" }] for SPONSOR_ADDRESS (and any other account the scripts sign with)
#   shop.json      the shop owner's account, opened on a Global FinReg business identity by src/identity/business-id.ts
#   till-key.txt   the till account's key, used once by src/registry/set-till.ts

# Optional settings (environment variables):
#   PORT=8080                      street server port
#   VIALE_PUBLIC_URL               public URL of this server (links in age-proof requests)
#   VIALE_ERRANDS_PER_HOUR=6       public errand limit
#   VIALE_AGE_PROOF_MINUTES=10     how long an errand waits for an 18+ proof
#   VIALE_KEYS_DIR=~/.viale-keys   where the files above live
#   VIALE_KEYS_BUNDLE              on a host: all of the above in one secret (src/chain/keys-bundle.ts)
#   CCD_GRPC_HOST / CCD_GRPC_PORT  testnet node (default grpc.testnet.concordium.com:20000)
